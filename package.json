{
  "name": "gant-workspace",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server start:dev",
    "dev": "pnpm run --parallel dev:web dev:server",
    "build:web": "pnpm --filter web build",
    "build:server": "pnpm --filter server build",
    "build": "pnpm build:web && pnpm build:server",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build --target universal-apple-darwin",
    "package:app": "bash scripts/package-app.sh",
    "test:gantt": "node scripts/test-gantt-adapter.mjs",
    "verify:ui": "node scripts/ui-verify/verify.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "bcrypt",
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "playwright-core": "^1.64.1"
  },
  "packageManager": "pnpm@10.34.8"
}
